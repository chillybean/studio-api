# Studio API Environment Variables

# Server
PORT=3007

# Firebase (uses service account)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# ==============================================
# AI PROVIDERS - Configure one or more
# ==============================================

# Default providers (which to use when not specified)
DEFAULT_TEXT_PROVIDER=gemini
DEFAULT_IMAGE_PROVIDER=stable-diffusion

# ---------------------------------------------
# Google Gemini (Text Generation)
# ---------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro

# ---------------------------------------------
# ComfyUI (Image Generation - Self-hosted)
# ---------------------------------------------
# COMFYUI_URL=http://localhost:8188
# COMFYUI_TIMEOUT=120000

# ---------------------------------------------
# Stable Diffusion (Image Generation)
# Works with: Automatic1111 WebUI, RunPod, etc.
# ---------------------------------------------
# SD_API_URL=http://localhost:7860
# SD_API_KEY=optional-api-key
# SD_MODEL=tattoo_style_v1.safetensors

# ---------------------------------------------
# Custom LLM (Self-hosted - Railway, RunPod, etc.)
# OpenAI-compatible API (works with Ollama, vLLM, LocalAI)
# ---------------------------------------------
# CUSTOM_LLM_URL=https://your-railway-app.up.railway.app
# CUSTOM_LLM_API_KEY=your-api-key
# CUSTOM_LLM_MODEL=llama2-tattoo

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://tat-life.web.app

# Environment
NODE_ENV=development
